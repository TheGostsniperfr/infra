{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Paris)"
  ],
  "minimumReleaseAge": "14 days",
  "argocd": {
    "fileMatch": ["k8s/apps/.*\\.yaml$"]
  },
  "kustomize": {
    "fileMatch": ["k8s/config/.*/kustomization\\.yaml$"]
  },
  "helm-values": {
    "fileMatch": ["k8s/config/.*/values.*\\.yaml$"]
  },
  "terraform": {
    "fileMatch": ["terraform/.*\\.tf$"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDatasources": ["helm"],
      "groupName": "Helm Charts (Minor & Patch)"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDatasources": ["terraform-provider"],
      "groupName": "Terraform Providers (Minor & Patch)"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchDatasources": ["docker"],
      "groupName": "Docker Images (Minor & Patch)"
    },
    {
      "matchPackageNames": ["plexinc/pms-docker"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+\\.\\d+-[0-9a-f]+$/"
    }
 ,
    {
      "description": "Our own website releases: no waiting period, both images in one PR, any day",
      "matchPackageNames": ["ghcr.io/arffornia/arffornia_website", "ghcr.io/arffornia/nginx_arffornia_website"],
      "minimumReleaseAge": "0 days",
      "groupName": "Arffornia website",
      "schedule": ["at any time"]
    },
    {
      "description": "Website images are tracked by the annotated regex manager only, so they are not bumped twice",
      "matchManagers": ["helm-values"],
      "matchPackageNames": ["ghcr.io/arffornia/arffornia_website", "ghcr.io/arffornia/nginx_arffornia_website"],
      "enabled": false
    }
  ],
  "schedule": ["before 5am on monday"],
  "prConcurrentLimit": 5,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["values.*\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s+.*?:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ]
}
