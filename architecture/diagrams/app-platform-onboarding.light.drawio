        <mxCell id="vso" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;b&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size:12px&quot;&gt;Vault Secrets Operator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#1e293b&quot; style=&quot;font-size:10px&quot;&gt;[VaultSecrets]&lt;/font&gt;&lt;/i&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#fff1f2;html=1;whiteSpace=wrap;strokeColor=#e11d48;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=50;spacingTop=6;spacingRight=8;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="3999" y="200" width="240" height="56" as="geometry" />
        </mxCell>
        <mxCell id="vso__icon" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;editable=0;connectable=0;movable=0;resizable=0;" vertex="1" parent="vso">
          <mxGeometry x="12" y="12" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;teams/&amp;lt;team&amp;gt;.yaml is the only input:&lt;br&gt;Terraform and Argo CD both read it&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="624" y="398" width="476" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-2" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;The state backend credentials live only&lt;br&gt;there: CI never applies Terraform&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="863" y="494" width="488" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Forks of the templates: the team owns its code.&lt;br&gt;DEPLOY_REPO_TOKEN: protected, main pipelines only&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1181" y="590" width="632" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-4" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Transit key: Vault signs with it, nobody can export it.&lt;br&gt;JWT role: accepts only an id_token of main of this app&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1407" y="686" width="710" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-5" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Public client with PKCE:&lt;br&gt;no client secret to leak&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="1845" y="782" width="344" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-6" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;Git generator: one Application team-&amp;lt;team&amp;gt;&lt;br&gt;per file, rendering charts/platform-team&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="2233" y="974" width="548" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-7" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;AppProject app-demo-timetrack: Argo CD may only deploy&lt;br&gt;into demo-timetrack, nothing cluster-wide&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="3136" y="1070" width="626" height="28" as="geometry" />
        </mxCell>
        <mxCell id="note-8" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;VaultSecret: a CR that VSO turns into a Secret,&lt;br&gt;with the namespace&amp;#39;s own Vault role&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=10;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="3845" y="1214" width="548" height="28" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
