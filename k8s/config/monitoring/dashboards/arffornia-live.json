          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max_over_time(sum(arffornia:players_online{namespace=\"arffornia-proxy-velocity\"})[$__range:1m])",
          "legendFormat": "",
